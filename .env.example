# GEMINI_API_KEY: Required for server-side Gemini AI concierge responses.
# Automatically injected at runtime from Settings > Secrets.
GEMINI_API_KEY=

# GOOGLE_MAPS_API_KEY: Required for server-side Google Maps Platform Geocoding & Geolocation APIs
# and dynamically exposed to the Maps JavaScript API map renderer.
GOOGLE_MAPS_API_KEY=

# VITE_GOOGLE_MAPS_API_KEY: Optional build-time browser Google Maps JavaScript API key.
VITE_GOOGLE_MAPS_API_KEY=

# APP_URL: Hosted application URL (injected automatically in production).
APP_URL=
